# Application Port (container fixed to 3000)
PORT=3000

# Client API URL (optional - empty defaults to relative /api/*)
VITE_API_URL=

# Supabase (optional - falls back to in-memory menu and order store)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot (optional - bot features skipped if not provided)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ADMIN_TELEGRAM_IDS=
MINI_APP_URL=
